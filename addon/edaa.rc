// Version information of EDAA.addon64 (shown by ReShade in the Add-ons tab and
// in the file properties). The numbers come from version.h, written by
// build_stamp.cmake from "git describe" or the release tag.

#include <winres.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION EDAA_VERSION_NUMBERS
PRODUCTVERSION EDAA_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Siegfried-Origin"
            VALUE "FileDescription", "EDAA: temporal anti-aliasing and upscaling for Elite Dangerous"
            VALUE "FileVersion", EDAA_VERSION_TEXT
            VALUE "OriginalFilename", "EDAA.addon64"
            VALUE "ProductName", "EDAA"
            VALUE "ProductVersion", EDAA_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
